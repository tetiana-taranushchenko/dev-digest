# @devdigest/mcp-server environment
# This server is a pure HTTP client — the DevDigest studio (server + client)
# must already be running separately, e.g. via ./scripts/dev.sh from the repo
# root, before this MCP server is started.

# Base URL of the local DevDigest API.
API_BASE_URL=http://localhost:3001

# Max time (ms) devdigest_run_agent_on_pr blocks waiting for a review run to
# finish before returning a "still_running" result instead of hanging forever.
# Described to the model as "~2 min". Must be a positive number.
REVIEW_TIMEOUT_MS=120000

# Interval (ms) between polls of GET /pulls/:id/runs while waiting for a
# review run to finish. Must be >= 1000 (the API's global rate limit is
# 120 req/min — see server/README.md).
POLL_INTERVAL_MS=2000

# Timeout (ms) for the repo/PR/agent resolution HTTP calls (GET /repos,
# GET /repos/:id/pulls, GET /agents).
RESOLVE_TIMEOUT_MS=20000
